# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# --- Database (Neon Postgres, added by the Vercel ↔ Neon integration) ---
# Use the pooled connection string. For local work without Neon you can use an embedded database:
#   DATABASE_URL=pglite:./.e2e-data/dev
DATABASE_URL=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Discord application (https://discord.com/developers/applications → OAuth2)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# The Discord user ID of the brokerage Owner. The first sign-in with this ID becomes Owner.
OWNER_DISCORD_ID=

# --- Images (Cloudinary, free plan) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Public URL, used in links, Open Graph and Discord posts ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Discord webhooks (all optional; each event is skipped when its URL is empty) ---
# Channel → Edit channel → Integrations → Webhooks → New webhook → Copy webhook URL
DISCORD_WEBHOOK_REVIEW_PENDING=
DISCORD_WEBHOOK_NEW_LISTING=
DISCORD_WEBHOOK_NEW_RENTAL=
DISCORD_WEBHOOK_NEW_BUSINESS=
DISCORD_WEBHOOK_SALE_RECORDED=
DISCORD_WEBHOOK_DEAL_STAGE=
DISCORD_WEBHOOK_CAREER_APPLICATION=

# Discord bot (phase 2): builds and runs the server. See the README's "The Discord bot" section.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Optional: defaults to AUTH_DISCORD_ID (the same Discord application)
DISCORD_APP_ID=

# --- End-to-end tests only. Never set on Vercel. Works only with a pglite: DATABASE_URL. ---
# E2E_TEST_AUTH=1
